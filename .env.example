# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=GTM-T4P7BL6D

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# Stripe billing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_EARLY=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_EARLY_ANNUAL=
STRIPE_PRICE_ID_STANDARD_ANNUAL=
# Legacy/old billing envs (kept for reference only; not used by current checkout flow)
# STRIPE_PRICE_EARLY_19=
# STRIPE_PRICE_PRO_29=

# Engine loop auth/scheduling
CRON_SECRET=
ENGINE_LOOP_SECRET=
ENGINE_LOOP_ENABLED=1
ENGINE_VERSION=v3
# Optional comma-separated mode allowlist for v4 rollout (e.g. investing,trading)
# ENGINE_V4_MODES=investing
# Decision governance layer (0/1)
ENGINE_GOVERNANCE_V1=0
# Advanced probabilistic layer (0/1). Requires governance enabled.
ENGINE_PROB_LAYER_V1=0

# Market data providers (optional but recommended)
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
# Alias also supported by the market client.
ALPHA_VANTAGE_API_KEY=
TWELVEDATA_API_KEY=
# Optional pool for multiple Twelve Data accounts/keys. The legacy TWELVEDATA_API_KEY is still used too.
TWELVEDATA_API_KEYS=
MARKET_DATA_STALE_FALLBACK_MS=21600000
NEXT_PUBLIC_FINNHUB_API_KEY=

# Broker bridge (optional)
BROKER_BRIDGE_URL=
SIGNALCORE_BROKER_BRIDGE_URL=
SIGNALCORE_BROKER_BRIDGE_KEY=
SNAPTRADE_CONNECT_URL=
SIGNALCORE_SNAPTRADE_CONNECT_URL=

# App controls
SC_TRIAL_DAYS=7
SC_FORCE_PRO=0
SC_OWNER_USER_ID=
SC_OWNER_USER_IDS=
FOUNDING_LEFT=0
NEXT_PUBLIC_FOUNDING_LEFT=0

# Marketing Ops creative/publishing gateway (optional)
CREATOMATE_API_KEY=
CREATOMATE_IMAGE_TEMPLATE_ID=
CREATOMATE_VIDEO_TEMPLATE_ID=
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID_LINKEDIN=
BUFFER_PROFILE_ID_X=
BUFFER_PROFILE_ID_FACEBOOK=
# Alternative profile map: {"linkedin":"...","x":"...","facebook":"..."}
BUFFER_PROFILE_IDS_JSON=

# Safety switches
# Keep this 0 in production unless you explicitly want in-memory fallback.
ALLOW_MEMORY_FALLBACK=0
# Keep this 0 unless you are intentionally resetting/rebuilding the Research Lab mirror.
RESEARCH_SUPABASE_ALLOW_REGRESSIVE_STATE=0

# R1 Investing account discovery: OFF until exact target schema/RLS and Clerk integration pass
# No user identity, account ID, service_role or secret credentials belong here.
INVESTING_R1_ACCOUNTS_READ_MODE=disabled
INVESTING_R1_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
