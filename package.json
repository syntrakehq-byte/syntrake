    "research:expansion-markets": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchExpansionMarketStudy.ts",
    "research:data-harvest": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runMarketDataHarvester.ts",
    "research:data-backfill": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runMarketDataBackfillWorker.ts",
    "research:data-backfill:loop": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runMarketDataBackfillWorker.ts --loop",
    "research:data-hunter": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchDataHunter.ts",
    "research:data-hunter:loop": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchDataHunter.ts --loop",
    "research:data-stage": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/prepareMarketDataStaging.ts",
    "paper:reconcile": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/reconcilePaperTrading.ts",
    "trading:scanner:fallback-catalog": "node scripts/trading/generateTradingScannerFallbackCatalog.mjs"
  },
  "overrides": {
    "@clerk/shared": "3.47.7",
    "js-cookie": "3.0.7",
    "ws": "8.21.0",
    "postcss": "8.5.14"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.3",
    "@next/third-parties": "^16.2.6",
    "@supabase/supabase-js": "2.93.3",
    "jiti": "1.21.7",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.564.0",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "^16.2.6",
    "pg": "^8.22.0",
    "playwright": "^1.58.2",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
