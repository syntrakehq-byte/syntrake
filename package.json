    "research:twelvedata-universe:manual": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runTwelveDataUniverseManualCampaign.ts",
    "research:twelvedata-universe:manual:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/trading/startTwelveDataUniverseManualCampaign.ps1",
    "research:twelvedata-archive": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runTwelveDataFullArchive.ts",
    "research:twelvedata-archive:full": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runTwelveDataFullArchive.ts --full-history --download",
    "research:opportunity-review": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchOpportunityReview.ts",
    "research:max-daemon": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchMaxDaemon.ts --loop",
    "research:max-daemon:once": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchMaxDaemon.ts",
    "research:max-daemon:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/trading/getResearchMaxDaemonStatus.ps1",
    "research:max-daemon:install-autostart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/trading/installResearchMaxDaemonScheduledTask.ps1",
    "research:max-daemon:remove-autostart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/trading/removeResearchMaxDaemonScheduledTask.ps1",
    "research:data-sync": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/syncHistoricalMarketData.ts",
    "research:data-audit": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runHistoricalCoverageAudit.ts",
