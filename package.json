    "research:data-health": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchDatasetHealthReport.ts",
    "research:data-inventory": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runResearchLocalArchiveInventory.ts",
    "research:twelvedata-universe": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runTwelveDataUniverseCatalog.ts",
    "research:twelvedata-universe:archive": "node -r ./scripts/register-alias.cjs ./node_modules/jiti/bin/jiti.js scripts/trading/runTwelveDataUniverseArchive.ts",
