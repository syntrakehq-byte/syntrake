FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY scripts ./scripts
COPY news-core ./news-core
COPY tsconfig.json ./tsconfig.json

ENV NODE_ENV=production
ENV NEWS_EXECUTION_MODE=FACTUAL

# tsx is intentionally present: the current worker is TypeScript and has no
# separate daemon compilation pipeline yet.
ENTRYPOINT ["node", "--import", "tsx/esm", "scripts/news-supervisor.ts"]
